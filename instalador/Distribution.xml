<installer-gui-script minSpecVersion="2">
    <title>SU_TITLE</title>
    <welcome file="Welcome.html" mime-type="text/html"/>
    <license file="License.txt" mime-type="text/plain"/>
    <conclusion file="Conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="15.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default">
            <line choice="io.github.gabriel-castiglia.wyrmhold.pkg"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="io.github.gabriel-castiglia.wyrmhold.pkg" visible="false">
        <pkg-ref id="io.github.gabriel-castiglia.wyrmhold.pkg"/>
    </choice>
    <pkg-ref id="io.github.gabriel-castiglia.wyrmhold.pkg" version="@VERSION@" onConclusion="none">Wyrmhold-component.pkg</pkg-ref>
</installer-gui-script>
